{
  "$id": "https://open-metadata.org/schema/type/ownerConfig.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Owner Configuration",
  "description": "Configuration for assigning owners to ingested entities following topology hierarchy with inheritance support. Supports single or multiple owners per entity and configurable priority order.",
  "javaType": "org.openmetadata.schema.type.OwnerConfig",
  "type": "object",
  "properties": {
    "default": {
      "description": "Default owner(s) applied to all entities when no specific owner is configured. Can be a single owner or a list of owners (user or team names/emails)",
      "oneOf": [
        {
          "type": "string",
          "description": "Single default owner"
        },
        {
          "type": "array",
          "description": "Multiple default owners",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      ],
      "examples": ["data-engineering-team", "admin@company.com", ["team1", "team2"]]
    },
    "service": {
      "description": "Owner(s) for the service level. Can be a single owner or a list of owners",
      "oneOf": [
        {
          "type": "string",
          "description": "Single service owner"
        },
        {
          "type": "array",
          "description": "Multiple service owners",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      ]
    },
    "database": {
      "description": "Owner(s) for database entities. Can be a single owner, a list of owners, or a map of database FQNs/names to their owner(s)",
      "oneOf": [
        {
          "type": "string",
          "description": "Single owner for all databases"
        },
        {
          "type": "array",
          "description": "Multiple owners for all databases",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        {
          "type": "object",
          "description": "Map of database FQNs/names to their owner(s). FQN matches are prioritized over simple name matches.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            ]
          },
          "examples": [{
            "sales_db": "sales-team",
            "analytics_db": ["analytics-team", "data-science-team"],
            "service.production_db": "prod-team"
          }]
        }
      ]
    },
    "databaseSchema": {
      "description": "Owner(s) for schema entities. Can be a single owner, a list of owners, or a map of schema FQNs/names to their owner(s). FQN matches are prioritized over simple name matches.",
      "oneOf": [
        {
          "type": "string",
          "description": "Single owner for all schemas"
        },
        {
          "type": "array",
          "description": "Multiple owners for all schemas",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        {
          "type": "object",
          "description": "Map of schema FQNs/names to their owner(s). FQN format: 'database.schema'",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            ]
          },
          "examples": [{
            "public": "public-schema-team",
            "analytics_db.analytics_schema": ["analytics-team", "reporting-team"]
          }]
        }
      ]
    },
    "table": {
      "description": "Owner(s) for table entities. Can be a single owner, a list of owners, or a map of table FQNs/names to their owner(s). FQN matches are prioritized over simple name matches.",
      "oneOf": [
        {
          "type": "string",
          "description": "Single owner for all tables"
        },
        {
          "type": "array",
          "description": "Multiple owners for all tables",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        {
          "type": "object",
          "description": "Map of table FQNs/names to their owner(s). FQN format: 'database.schema.table'",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            ]
          },
          "examples": [{
            "customers": "customer-data-team",
            "sales_db.public.orders": ["sales-team", "finance-team"]
          }]
        }
      ]
    },
    "enableInheritance": {
      "description": "Enable child entities to inherit owner from parent entities when they don't have a specific owner configured",
      "type": "boolean",
      "default": true
    },
    "ownerPriority": {
      "description": "Configure the priority order for owner resolution. Available options: 'rule' (configured rules), 'source' (inherited from parent), 'default' (default owner). Default order: ['rule', 'source', 'default']",
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["rule", "source", "default"]
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 3,
      "default": ["rule", "source", "default"],
      "examples": [
        ["rule", "source", "default"],
        ["rule", "default"],
        ["source", "rule", "default"]
      ]
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "default": "data-platform-team"
    },
    {
      "default": ["data-team", "platform-team"],
      "database": "database-admins",
      "databaseSchema": "schema-owners",
      "table": "table-stewards",
      "enableInheritance": true,
      "ownerPriority": ["rule", "source", "default"]
    },
    {
      "default": "data-team",
      "database": {
        "sales_db": "sales-team",
        "analytics_db": ["analytics-team", "data-science-team"],
        "service.production_db": "prod-team"
      },
      "databaseSchema": {
        "public": "public-team",
        "analytics_db.reporting": ["reporting-team", "analytics-team"]
      },
      "enableInheritance": true,
      "ownerPriority": ["rule", "default"]
    }
  ]
}

