{
  "$id": "https://open-metadata.org/schema/type/ownerConfig.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Owner Configuration",
  "description": "Configuration for assigning owners to ingested entities following topology hierarchy with inheritance support",
  "javaType": "org.openmetadata.schema.type.OwnerConfig",
  "type": "object",
  "properties": {
    "default": {
      "description": "Default owner(s) applied to all entities when no specific owner is configured. Can be a single owner or multiple owners (user or team name/email)",
      "oneOf": [
        {
          "type": "string",
          "description": "Single owner name/email"
        },
        {
          "type": "array",
          "description": "Multiple owners",
          "items": {
            "type": "string"
          }
        }
      ],
      "examples": ["data-engineering-team", ["data-team", "admin@company.com"]]
    },
    "service": {
      "description": "Owner(s) for the service level. Can be a single owner or multiple owners",
      "oneOf": [
        {
          "type": "string",
          "description": "Single owner name/email"
        },
        {
          "type": "array",
          "description": "Multiple owners",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "database": {
      "description": "Owner(s) for database entities. Can be a single owner, multiple owners, or a map of database names to their owner(s)",
      "oneOf": [
        {
          "type": "string",
          "description": "Single owner for all databases"
        },
        {
          "type": "array",
          "description": "Multiple owners for all databases",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "description": "Map of database names to their owner(s)",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "examples": [{
            "sales_db": "sales-team",
            "analytics_db": ["analytics-team", "data-science-team"]
          }]
        }
      ]
    },
    "databaseSchema": {
      "description": "Owner(s) for schema entities. Can be a single owner, multiple owners, or a map of schema FQNs to their owner(s)",
      "oneOf": [
        {
          "type": "string",
          "description": "Single owner for all schemas"
        },
        {
          "type": "array",
          "description": "Multiple owners for all schemas",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "description": "Map of schema names/FQNs to their owner(s)",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "examples": [{
            "public": "public-schema-team",
            "analytics_db.analytics_schema": ["analytics-team", "reporting-team"]
          }]
        }
      ]
    },
    "table": {
      "description": "Owner(s) for table entities. Can be a single owner, multiple owners, or a map of table FQNs to their owner(s)",
      "oneOf": [
        {
          "type": "string",
          "description": "Single owner for all tables"
        },
        {
          "type": "array",
          "description": "Multiple owners for all tables",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "description": "Map of table names/FQNs to their owner(s)",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "examples": [{
            "customers": "customer-data-team",
            "sales_db.public.orders": ["sales-team", "finance-team"]
          }]
        }
      ]
    },
    "enableInheritance": {
      "description": "Enable child entities to inherit owner from parent entities when they don't have a specific owner configured",
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "default": "data-platform-team"
    },
    {
      "default": ["data-team", "governance-team"],
      "database": "database-admins",
      "databaseSchema": "schema-owners",
      "table": "table-stewards",
      "enableInheritance": true
    },
    {
      "default": "data-team",
      "database": {
        "sales_db": "sales-team",
        "analytics_db": ["analytics-team", "data-science-team"]
      },
      "databaseSchema": {
        "public": "public-team",
        "analytics_db.reporting": ["reporting-team", "bi-team"]
      },
      "table": {
        "customers": "customer-team",
        "sales_db.public.orders": ["sales-team", "finance-team"]
      },
      "enableInheritance": true
    }
  ]
}

